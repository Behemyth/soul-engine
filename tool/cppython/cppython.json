{
    "version": 9,
    "configurePresets": [
        {
            "name": "cppython",
            "description": "Injected configuration preset for CPPython",
            "hidden": true,
            "toolchainFile": "${sourceDir}/build/conan/Release/generators/conan_toolchain.cmake"
        },
        {
            "name": "cppython-release",
            "description": "CPPython dependency toolchain for Release",
            "hidden": true,
            "inherits": "cppython",
            "toolchainFile": "${sourceDir}/build/conan/Release/generators/conan_toolchain.cmake"
        },
        {
            "name": "cppython-debug",
            "description": "CPPython dependency toolchain for Debug",
            "hidden": true,
            "inherits": "cppython",
            "toolchainFile": "${sourceDir}/build/conan/Debug/generators/conan_toolchain.cmake"
        }
    ]
}